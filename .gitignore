# Vaultix secrets are age-encrypted (*.age) or re-encrypted per-host
# (secrets/cache/) — both belong in git. Only plaintext must never be
# committed, so guard the file names instead:
# secrets/*.txt
# secrets/*.plain
*.key
*.pem
secrets.nix

# Local history
.history/